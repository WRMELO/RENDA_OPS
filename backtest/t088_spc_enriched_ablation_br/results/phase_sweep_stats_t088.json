    "arm_definitions": {
      "Baseline": "Regra 1 apenas (any_rule: ponto alem dos limites de 3-sigma em qualquer carta)",
      "B": "Regra 1 + W2/W3/W4/N3 aplicadas na carta de valor (i_value)",
      "B_plus_C": "Arm B + W4/N3 aplicadas na carta de dispersao (mr_value)"
    },
    "gate_scope": "Gate de entrada (select_top_n) E release de quarentena simulado (ticker bloqueado por arm em d_prev nao entra na arm_selected, independentemente de ciclos anteriores)",
