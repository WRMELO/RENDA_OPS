    },
    "verdict_per_arm": {
      "implementar": "arm_better_tail AND (arm_better_sharpe OR arm_recidiva_meaningful)",
      "descartar": "NOT arm_better_tail AND NOT arm_better_sharpe AND NOT arm_recidiva_meaningful",
      "inconclusivo": "qualquer outro caso"
    },
    "thresholds": {
      "arm_better_tail": "mean(cvar5_arm_holdout) > mean(cvar5_baseline_holdout)",
      "arm_better_sharpe": "mean(sharpe_arm_cost_adj_holdout) > mean(sharpe_baseline_holdout)",
      "arm_recidiva_meaningful": "mean(recidiva_avoidance_rate_arm_holdout) > 0.30"
    },
    "final_verdict_logic": "Se B_plus_C IMPLEMENTAR e B IMPLEMENTAR: escolher braco com maior melhora cumulativa em cvar5 + sharpe. Se apenas um IMPLEMENTAR: esse braco. Se nenhum IMPLEMENTAR e todos DESCARTAR: DESCARTAR_ENRIQUECIMENTO. Caso contrario: INCONCLUSIVO."
